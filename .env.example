VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics 4 Measurement ID (GA4 → Admin → Data streams → your web stream).
# Leave unset to run first-party analytics only — GA4 then never loads.
VITE_GA4_ID=G-XXXXXXXXXX

# Cloudflare Web Analytics site token. LEAVE BLANK — veloxhouse.co.uk is already set up
# in Cloudflare on "Automatic setup", which injects the beacon at the edge. Filling this
# in would load a second beacon and double-count every page view. Only set it if
# automatic injection is turned off (Web Analytics → Manage site → RUM).
VITE_CF_BEACON_TOKEN=
