VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics 4 Measurement ID (GA4 → Admin → Data streams → your web stream).
# Leave unset to run first-party analytics only — GA4 then never loads.
VITE_GA4_ID=G-XXXXXXXXXX

# Cloudflare Web Analytics site token (Cloudflare dashboard → Analytics & Logs →
# Web Analytics → your site → "JS snippet", the value of data-cf-beacon token).
# Cookieless, so it counts every visitor — not just the ones who accept cookies.
# Leave unset and no beacon loads.
VITE_CF_BEACON_TOKEN=
